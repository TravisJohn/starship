{
  "compilerOptions": {
    "composite": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist/main",
    "rootDir": "src/main",
    "skipLibCheck": true
  },
  "include": ["src/main/**/*.ts"],
  "references": [
    {
      "path": "./tsconfig.shared.json"
    }
  ]
}
