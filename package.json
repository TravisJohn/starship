{
  "name": "starship",
  "version": "0.1.0",
  "private": true,
  "description": "Starship Phase 1 shell",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:main && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:main": "tsc -b tsconfig.shared.json tsconfig.main.json",
    "build:renderer": "tsc -b tsconfig.shared.json tsconfig.renderer.json && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "test": "vitest run",
    "verify:shelf": "npm run build && node scripts/verify-shelf-persistence.cjs",
    "verify:terminal:powershell": "npm run build && node scripts/verify-terminal-powershell.cjs",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-rebuild --only better-sqlite3 && electron-rebuild --only node-pty || node scripts/verify-native-modules.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.11.1",
    "electron": "latest",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "latest",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron-builder": "latest",
    "playwright-core": "^1.61.1",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "dev.travis.starship",
    "productName": "Starship",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
